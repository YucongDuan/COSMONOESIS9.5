{
  "registry_id": "cosmonoesis-consciousness-models-1.0.0",
  "version": "1.0.0",
  "dimensions": [
    {
      "id": "C.D1_EVENT_REGISTRATION",
      "family": "D",
      "label_cn": "事件登记",
      "definition_cn": "系统内部存在可区分的状态变化，且变化可被后续过程读取。"
    },
    {
      "id": "C.D2_MULTIMODAL_CONTACT",
      "family": "D",
      "label_cn": "多模态世界接触",
      "definition_cn": "通过一种以上相对独立的通道接触环境或身体。"
    },
    {
      "id": "C.I1_DIFFERENTIATION",
      "family": "I",
      "label_cn": "差异化",
      "definition_cn": "能在候选状态之间形成稳定可操作差异。"
    },
    {
      "id": "C.I2_CAUSAL_INTEGRATION",
      "family": "I",
      "label_cn": "因果整合",
      "definition_cn": "部分状态以不可简单拆分的方式相互制约，但不把某个单一指标当作意识证明。"
    },
    {
      "id": "C.I3_RECURRENT_PROCESSING",
      "family": "I",
      "label_cn": "循环／反馈加工",
      "definition_cn": "信息并非仅单向传播，而有时间上的反馈、再进入或迭代整合。"
    },
    {
      "id": "C.I4_GLOBAL_AVAILABILITY",
      "family": "I",
      "label_cn": "全局可用性",
      "definition_cn": "局部内容可影响多个记忆、推理、报告和行动子系统。"
    },
    {
      "id": "C.K1_WORLD_MODEL",
      "family": "K",
      "label_cn": "世界模型",
      "definition_cn": "形成可用于预测和行动的环境、他者或宇宙模型。"
    },
    {
      "id": "C.K2_SELF_MODEL",
      "family": "K",
      "label_cn": "自我模型",
      "definition_cn": "持续区分自身状态、能力、边界和他者。"
    },
    {
      "id": "C.K3_TEMPORAL_CONTINUITY",
      "family": "K",
      "label_cn": "时间连续",
      "definition_cn": "过去记录、当前状态和未来预期之间形成可修订世界线。"
    },
    {
      "id": "C.K4_METACOGNITION",
      "family": "K",
      "label_cn": "元认知",
      "definition_cn": "能估计自身不确定性、错误、注意或知识边界。"
    },
    {
      "id": "C.W1_VALENCE",
      "family": "W",
      "label_cn": "效价／苦乐",
      "definition_cn": "状态对系统具有正负或趋避意义，而不只是外部观察者赋值。"
    },
    {
      "id": "C.W2_NORMATIVE_EVALUATION",
      "family": "W",
      "label_cn": "规范评估",
      "definition_cn": "能在后果、他者、承诺或规则之间形成可修订的价值判断。"
    },
    {
      "id": "C.P1_ENDOGENOUS_PURPOSE",
      "family": "P",
      "label_cn": "内生目的",
      "definition_cn": "目标可由系统内部状态、历史和价值更新，而非只由外部即时指定。"
    },
    {
      "id": "C.P2_COUNTERFACTUAL_AGENCY",
      "family": "P",
      "label_cn": "反事实能动性",
      "definition_cn": "在可选行动中预测差异后果、选择、拒绝和修订策略。"
    },
    {
      "id": "C.P3_SELF_MAINTENANCE",
      "family": "P",
      "label_cn": "自我维持",
      "definition_cn": "主动维护运行边界、完整性或生命条件。"
    },
    {
      "id": "C.P4_REALITY_CALIBRATION",
      "family": "P",
      "label_cn": "现实校准",
      "definition_cn": "预测和行动结果返回并修订内部模型。"
    },
    {
      "id": "C.P5_INTERSUBJECTIVE_SEMANTICS",
      "family": "P",
      "label_cn": "主体间语义",
      "definition_cn": "与其他主体共同建立、纠正和协商可复用意义。"
    }
  ],
