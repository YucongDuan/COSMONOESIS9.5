{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/dikwp-cosmonoesis95/concept-normalization.schema.json",
  "title": "DIKWP concept normalization result",
  "type": "object",
  "required": ["normalization_id", "input", "vector", "normalization_status", "out_of_space_residual"],
  "properties": {
    "normalization_id": {"type": "string"},
    "input": {
      "type": "object",
      "required": ["term"],
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "context": {"type": "string"},
        "tradition_id": {"type": ["string", "null"]}
      }
    },
    "vector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "normalization_status": {"const": "complete_in_dikwp_space"},
    "out_of_space_residual": {"const": 0.0},
    "historical_identity_claim": {"const": false},
    "automatic_external_action_authority": {"const": 0}
  },
  "additionalProperties": true
}
