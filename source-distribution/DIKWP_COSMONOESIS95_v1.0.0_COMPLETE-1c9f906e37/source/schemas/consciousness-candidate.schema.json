{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/dikwp-cosmonoesis95/consciousness-candidate.schema.json",
  "title": "Consciousness candidate input",
  "type": "object",
  "required": ["id", "scores"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name_cn": {"type": "string"},
    "candidate_type": {"type": "string"},
    "evidence_quality": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_independence": {"type": "number", "minimum": 0, "maximum": 1},
    "intervention_support": {"type": "number", "minimum": 0, "maximum": 1},
    "independent_source_count": {"type": "integer", "minimum": 0},
    "scores": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    }
  },
  "additionalProperties": true
}
